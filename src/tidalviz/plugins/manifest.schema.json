{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidalviz.local/manifest.schema.json",
  "title": "Tidalviz manifest (tidalviz.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "visualizers"],
  "properties": {
    "apiVersion": { "const": 1 },
    "visualizers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/visualizer" }
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))[^\\u0000:]+$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "visualizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "entry", "renderer"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "type": "string", "maxLength": 1000 },
        "author": { "$ref": "#/$defs/text" },
        "entry": { "$ref": "#/$defs/relPath" },
        "renderer": { "enum": ["2d", "webgl2", "webgpu", "three"] },
        "fallback": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
        "libs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["three"] }
        },
        "thumbnail": { "$ref": "#/$defs/relPath" },
        "params": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/param" }
        }
      }
    },
    "paramBase": {
      "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$" },
      "label": { "$ref": "#/$defs/text" }
    },
    "param": {
      "type": "object",
      "required": ["id", "type", "label", "default"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "id": { "$ref": "#/$defs/paramBase/id" },
            "label": { "$ref": "#/$defs/text" },
            "type": { "const": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/paramBase/id" },
            "label": { "$ref": "#/$defs/text" },
            "type": { "const": "color" },
            "default": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/paramBase/id" },
            "label": { "$ref": "#/$defs/text" },
            "type": { "const": "boolean" },
            "default": { "type": "boolean" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["options"],
          "properties": {
            "id": { "$ref": "#/$defs/paramBase/id" },
            "label": { "$ref": "#/$defs/text" },
            "type": { "const": "select" },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/text" }
            },
            "default": { "type": "string" }
          }
        }
      ]
    }
  }
}
