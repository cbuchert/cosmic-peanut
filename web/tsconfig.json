{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "three": ["./node_modules/@types/three"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["sdk/**/*.js", "sdk/**/*.d.ts", "shell/**/*.js", "../plugins/**/*.js"],
  "exclude": ["node_modules", "vendor"]
}
