{
  "apiVersion": 1,
  "visualizers": [
    {
      "id": "bars",
      "name": "Bars",
      "description": "Spectrum bars with falling peak caps and a live waveform line.",
      "author": "Tidalviz",
      "entry": "src/bars.js",
      "renderer": "2d",
      "thumbnail": "thumbs/bars.jpg",
      "params": [
        { "id": "color", "type": "color", "label": "Color", "default": "#46d7ff" },
        { "id": "count", "type": "select", "label": "Bars", "options": ["16", "32", "64"], "default": "64" },
        { "id": "mirror", "type": "boolean", "label": "Mirror", "default": false },
        { "id": "smoothing", "type": "number", "label": "Smoothing", "min": 0, "max": 0.95, "step": 0.01, "default": 0.6 },
        { "id": "waveform", "type": "boolean", "label": "Waveform", "default": true }
      ]
    },
    {
      "id": "undertow",
      "name": "Undertow",
      "description": "Feedback-warp rings that breathe with the bass.",
      "author": "Tidalviz",
      "entry": "src/undertow.js",
      "renderer": "webgl2",
      "libs": [],
      "thumbnail": "thumbs/undertow.jpg",
      "params": [
        { "id": "speed", "type": "number", "label": "Speed", "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "id": "tint", "type": "color", "label": "Tint", "default": "#7cf0ff" },
        { "id": "mirror", "type": "boolean", "label": "Mirror", "default": false },
        { "id": "mode", "type": "select", "label": "Mode", "options": ["rings", "bars"], "default": "rings" }
      ]
    },
    {
      "id": "orbit",
      "name": "Orbit",
      "description": "Sixty-four glowing pillars on a ring; the camera circles on the beat.",
      "author": "Tidalviz",
      "entry": "src/orbit.js",
      "renderer": "three",
      "libs": ["three"],
      "thumbnail": "thumbs/orbit.jpg",
      "params": [
        { "id": "color", "type": "color", "label": "Color", "default": "#8f6bff" },
        { "id": "bloom", "type": "number", "label": "Bloom", "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "id": "spin", "type": "number", "label": "Camera speed", "min": 0, "max": 2, "step": 0.01, "default": 1 }
      ]
    },
    {
      "id": "pulsar",
      "name": "Pulsar",
      "description": "Ridge lines after the Unknown Pleasures cover: each new line is a moment of the music.",
      "author": "Tidalviz",
      "entry": "src/pulsar.js",
      "renderer": "2d",
      "thumbnail": "thumbs/pulsar.jpg",
      "params": [
        { "id": "lines", "type": "select", "label": "Lines", "options": ["40", "60", "80", "100", "120"], "default": "80" },
        { "id": "speed", "type": "number", "label": "Speed", "min": 1, "max": 30, "step": 0.5, "default": 10 },
        { "id": "height", "type": "number", "label": "Height", "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "id": "color", "type": "color", "label": "Color", "default": "#ffffff" },
        { "id": "lineWidth", "type": "number", "label": "Line width", "min": 0.5, "max": 4, "step": 0.1, "default": 1.5 }
      ]
    },
    {
      "id": "stargate",
      "name": "Stargate",
      "description": "Hurtle and roll between two infinite planes of slit-scan light seeded by the waveform, after 2001's Star Gate.",
      "author": "Tidalviz",
      "entry": "src/stargate.js",
      "renderer": "webgl2",
      "thumbnail": "thumbs/stargate.jpg",
      "params": [
        { "id": "speed", "type": "number", "label": "Speed", "min": 0, "max": 3, "step": 0.05, "default": 1 },
        { "id": "roll", "type": "number", "label": "Roll (rad/s)", "min": -1.5, "max": 1.5, "step": 0.01, "default": 0.25 },
        { "id": "detail", "type": "select", "label": "Detail", "options": ["low", "medium", "high"], "default": "medium" },
        { "id": "streak", "type": "number", "label": "Streak", "min": 0, "max": 1, "step": 0.01, "default": 0.5 },
        { "id": "spread", "type": "number", "label": "Field of view", "min": 0.5, "max": 1.8, "step": 0.01, "default": 1 },
        { "id": "brightness", "type": "number", "label": "Brightness", "min": 0.2, "max": 2.5, "step": 0.01, "default": 1 },
        { "id": "palette", "type": "select", "label": "Palette", "options": ["film", "ember", "ice", "mono"], "default": "film" }
      ]
    },
    {
      "id": "blaze",
      "name": "Blaze",
      "description": "A fire simulation fed by the waveform: loud, jagged passages throw up tall tongues, bass stokes it, beats flare.",
      "author": "Tidalviz",
      "entry": "src/blaze.js",
      "renderer": "webgl2",
      "libs": [],
      "thumbnail": "thumbs/blaze.jpg",
      "params": [
        { "id": "intensity", "type": "number", "label": "Intensity", "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "id": "height", "type": "number", "label": "Flame height", "min": 0.3, "max": 2, "step": 0.01, "default": 1 },
        { "id": "turbulence", "type": "number", "label": "Turbulence", "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "id": "speed", "type": "number", "label": "Speed", "min": 0.2, "max": 2, "step": 0.01, "default": 1 },
        { "id": "glow", "type": "number", "label": "Glow", "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "id": "palette", "type": "select", "label": "Palette", "options": ["natural", "blue gas", "green chemical", "ember mono"], "default": "natural" },
        { "id": "detail", "type": "number", "label": "Detail", "min": 0.15, "max": 0.5, "step": 0.05, "default": 0.3 }
      ]
    }
  ]
}
